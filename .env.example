# mock = deterministic stand-in, no network, no key needed (default)
# live = call the real TypeSafe API
JEV_MODE=mock

# Read by the TypeSafe SDK itself, not by this code.
# Required only when JEV_MODE=live. Jev is in early access as of Sept 2026.
TYPESAFE_API_KEY=

JEV_MODEL=jev-latest

# How close to a policy threshold counts as "too close to call". If moving a
# probability by this much would flip the routing outcome, escalate instead.
# NOTE: thresholds near the ceiling need tight margins. A 0.10 margin around a
# 0.90 threshold makes nothing below 1.00 non-fragile.
FRAGILE_MARGIN=0.03

# Where the service catalogue lives (tier, owner, environment).
SERVICE_CATALOG=fixtures/service-catalog.json

# true = print routes, never deliver. Keep it true until shadow mode is done.
ROUTER_DRY_RUN=true

# scripts/benchmark.py only. 40 cycles the four fixtures ten times each,
# which is the sample the write-up reports.
BENCH_RUNS=40

# mock = deterministic stand-in, no network, no key needed (default)
# live = call the real TypeSafe API
JEV_MODE=mock

# Required only when JEV_MODE=live. Get one from the TypeSafe console.
# Jev is in early access as of September 2026.
TYPESAFE_API_KEY=

JEV_MODEL=jev-latest

# Demonstration thresholds. Calibrate against your own incident history.
REVIEW_BELOW_CERTAINTY=0.70
FLAG_BELOW_CERTAINTY=0.95

# true = print routes, never deliver. Keep it true until shadow mode is done.
ROUTER_DRY_RUN=true
